{
  "name": "Isolated Tor Workspace",
  "dockerComposeFile": "docker-compose.yml",
  "service": "dev-container",
  "workspaceFolder": "/workspace",

  "containerEnv": {
    "HTTP_PROXY": "socks5://tor-proxy:9050",
    "HTTPS_PROXY": "socks5://tor-proxy:9050",
    "ALL_PROXY": "socks5://tor-proxy:9050"
  },

  "customizations": {
    "jetbrains": {
      "plugins": [
        "ai.opencode.intellij"
      ]
    }
  }
}
