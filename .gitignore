# megahack-research — nothing that cannot be inspected in a text editor is tracked.
#
# This repository publishes understanding and original tooling. Absolllute's
# binaries, their shipped assets, and raw decompiler output never enter the index.
# To force-add something here, it must be deliberate and it must be defensible.

# --- Samples and the ground-truth binary set ---------------------------------
# The Mega Hack release, its .geode package, the vendored Python toolchain and the
# original RE notes. Evidence, not source. See docs/GOALS.md and AGENTS.md.
samples/
*.geode
*.geode.zip
.geode_cache
.analysis_tools/

# --- Native and packaged binaries --------------------------------------------
*.dll
*.so
*.dylib
*.exe
*.lib
*.a
*.obj
*.pdb
*.zip
*.7z
*.apk
*.ipa

# --- Runtime data and scratch databases --------------------------------------
# best_runs.bin and friends are player data, not source.
runtime-traces/
*.bin
*.tmp
*.bak
*.db
*.sqlite
*.log

# --- Shipped assets -----------------------------------------------------------
# Mega Hack's sprites and audio are Absolllute's work. Do not commit them.
*.png
*.jpg
*.jpeg
*.gif
*.mp3
*.ogg
*.wav
*.mp4
*.ttf
*.otf

# --- Decompiler output and analysis databases ---------------------------------
# These are caches, and the decompiled tree is Absolllute's pseudocode. Promote
# a *finding* into notes/, never the raw dump.
recovered/
decompiled/
ghidra_out/
reports/
*.gpr
*.rep/
*.i64
*.idb
*.id0
*.id1
*.nam
*.til
*.gbf

# --- Python -------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Node ---------------------------------------------------------------------
# Installed dependencies for the opencode plugin manifest. package.json and the
# lockfile are tracked; the installed tree never is.
node_modules/

# --- Long-run wrapper scratch --------------------------------------------------
.oc/
.opencode/
# Local emergency-stop helper for the agent loop; not part of the project.
/LoopEmergencyStop.ps1

# --- Watchdog runtime state ----------------------------------------------------
# Generated worker, pid file and log. The script that writes them is tracked.
scripts/.watchdog/

# --- Editors, OS, tooling -----------------------------------------------------
.idea/
.vscode/
.vs/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
.keepalive.log
